# Copy to .env for local overrides (docker-compose.yml already has working dev defaults).

DATABASE_URL=postgresql+asyncpg://memory:memory_dev_password@db:5432/memory
GIT_REPO_PATH=/data/git-repo

# auth_mode: "dev" checks DEV_BEARER_TOKEN, "oidc" introspects against Authelia (production)
AUTH_MODE=dev
DEV_BEARER_TOKEN=dev-local-token

OIDC_INTROSPECTION_URL=https://authelia.bay-ram.de/api/oidc/introspection
OIDC_CLIENT_ID=memory-service
OIDC_CLIENT_SECRET=

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
